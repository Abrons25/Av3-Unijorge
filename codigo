<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LogicLingo Web - Modelagem e Simulação Matemática</title>
    <style>
        :root {
            --green: #58cc02;
            --green-dark: #46a302;
            --blue: #1cb0f6;
            --blue-dark: #1899d6;
            --red: #ff4b4b;
            --red-dark: #ea2b2b;
            --yellow: #ffc800;
            --purple: #ce82ff;
            --purple-dark: #a552db;
            --orange: #ff9600;
            --orange-dark: #cc7800;
            --bg-light: #f7f9fa;
            --border-color: #e5e5e5;
            --text-dark: #3c3c3c;
            --text-muted: #777777;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* BARRA LATERAL ESQUERDA (SIDEBAR) */
        .sidebar {
            width: 260px;
            background: #ffffff;
            border-right: 2px solid var(--border-color);
            padding: 28px 20px;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 10;
        }

        .brand {
            font-size: 1.65rem;
            font-weight: 900;
            color: var(--green);
            margin-bottom: 36px;
            padding-left: 12px;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-menu {
            display: flex;
            flex-direction: column;
            gap: 10px;
            flex: 1;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            border-radius: 14px;
            border: 2px solid transparent;
            background: none;
            font-size: 0.95rem;
            font-weight: 800;
            color: var(--text-muted);
            cursor: pointer;
            text-align: left;
            text-transform: uppercase;
            transition: all 0.15s;
        }

        .nav-item:hover {
            background-color: #f3f4f6;
        }

        .nav-item.active {
            background-color: #ddf4ff;
            border-color: #84d8ff;
            color: var(--blue-dark);
        }

        .sidebar-footer {
            font-size: 0.78rem;
            color: var(--text-muted);
            border-top: 2px solid var(--border-color);
            padding-top: 16px;
            line-height: 1.5;
        }

        /* ESTRUTURA PRINCIPAL DESKTOP */
        .desktop-wrapper {
            margin-left: 260px;
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 32px;
            max-width: 1380px;
            padding: 36px 42px;
            width: 100%;
        }

        /* COLUNA CENTRAL */
        .center-column {
            min-width: 0;
        }

        .page-header {
            background: #ffffff;
            border: 2px solid var(--border-color);
            border-radius: 20px;
            padding: 24px 28px;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-header h1 {
            font-size: 1.55rem;
            margin-bottom: 6px;
            color: var(--text-dark);
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .view-section {
            display: none;
        }

        .view-section.active {
            display: block;
        }

        /* GRADE DE UNIDADES (TRILHA DESKTOP) */
        .units-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .unit-card {
            background: #ffffff;
            border: 2px solid var(--border-color);
            border-bottom-width: 6px;
            border-radius: 20px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.15s;
        }

        .unit-card:hover {
            transform: translateY(-3px);
        }

        .unit-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .unit-tag {
            font-size: 0.76rem;
            font-weight: 800;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 20px;
            color: #ffffff;
        }

        .unit-status {
            font-size: 0.85rem;
            font-weight: 800;
        }

        .unit-card h3 {
            font-size: 1.25rem;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .unit-card p {
            font-size: 0.92rem;
            color: var(--text-muted);
            line-height: 1.5;
            margin-bottom: 22px;
        }

        /* BOTÕES 3D */
        .btn-3d {
            width: 100%;
            padding: 14px 20px;
            border: none;
            border-radius: 14px;
            font-weight: 800;
            font-size: 0.95rem;
            text-transform: uppercase;
            color: #ffffff;
            cursor: pointer;
            transition: all 0.1s;
        }

        .btn-3d:active {
            transform: translateY(2px);
            border-bottom-width: 2px;
        }

        .btn-green { background: var(--green); border-bottom: 4px solid var(--green-dark); }
        .btn-blue { background: var(--blue); border-bottom: 4px solid var(--blue-dark); }
        .btn-purple { background: var(--purple); border-bottom: 4px solid var(--purple-dark); }
        .btn-orange { background: var(--orange); border-bottom: 4px solid var(--orange-dark); }

        /* SEÇÃO DO GUIA TEÓRICO EM GRADE */
        .theory-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .theory-card {
            background: #ffffff;
            border: 2px solid var(--border-color);
            border-radius: 20px;
            padding: 24px;
        }

        .theory-card.full-width {
            grid-column: 1 / -1;
        }

        .theory-card h3 {
            color: var(--blue-dark);
            font-size: 1.18rem;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 2px solid var(--bg-light);
        }

        .theory-card p, .theory-card li {
            font-size: 0.94rem;
            line-height: 1.6;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .theory-card ul {
            padding-left: 20px;
        }

        .code-pill {
            background: #eef9ff;
            color: #0b6fa4;
            padding: 2px 7px;
            border-radius: 6px;
            font-weight: 700;
            font-family: monospace;
        }

        .truth-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 14px;
            font-size: 0.9rem;
            text-align: center;
        }

        .truth-table th, .truth-table td {
            border: 1px solid #dcdcdc;
            padding: 10px;
        }

        .truth-table th {
            background: #eef9ff;
            color: var(--text-dark);
            font-weight: 800;
        }

        /* COLUNA LATERAL DIREITA (WIDGETS DESKTOP) */
        .right-column {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .stats-bar {
            background: #ffffff;
            border: 2px solid var(--border-color);
            border-radius: 18px;
            padding: 16px 20px;
            display: flex;
            justify-content: space-around;
            font-weight: 900;
            font-size: 1.1rem;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .widget-box {
            background: #ffffff;
            border: 2px solid var(--border-color);
            border-radius: 20px;
            padding: 22px;
        }

        .widget-box h4 {
            font-size: 1rem;
            text-transform: uppercase;
            color: var(--text-dark);
            margin-bottom: 14px;
            letter-spacing: 0.5px;
        }

        .cheat-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 10px;
            font-size: 0.88rem;
        }

        .cheat-list li {
            display: flex;
            justify-content: space-between;
            padding-bottom: 8px;
            border-bottom: 1px dashed var(--border-color);
        }

        /* MODO DE LIÇÃO / QUIZ EM TELA CHEIA DESKTOP */
        .quiz-modal {
            position: fixed;
            inset: 0;
            background: #ffffff;
            z-index: 100;
            display: none;
            flex-direction: column;
        }

        .quiz-modal.active {
            display: flex;
        }

        .quiz-top {
            max-width: 1000px;
            width: 100%;
            margin: 0 auto;
            padding: 28px 24px;
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .btn-close {
            background: none;
            border: none;
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-muted);
            cursor: pointer;
        }

        .progress-track {
            flex: 1;
            height: 16px;
            background: var(--border-color);
            border-radius: 12px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            width: 0%;
            background: var(--green);
            transition: width 0.3s ease;
        }

        .quiz-center {
            flex: 1;
            max-width: 780px;
            width: 100%;
            margin: 0 auto;
            padding: 20px 24px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .quiz-badge {
            font-size: 0.85rem;
            font-weight: 800;
            color: var(--blue-dark);
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .quiz-title {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 32px;
            line-height: 1.35;
        }

        .options-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .option-card {
            background: #ffffff;
            border: 2px solid var(--border-color);
            border-bottom-width: 5px;
            border-radius: 16px;
            padding: 20px;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text-dark);
            text-align: left;
            cursor: pointer;
            transition: all 0.12s;
        }

        .option-card:hover {
            background: #f8fafc;
        }

        .option-card.selected {
            border-color: var(--blue);
            background: #ddf4ff;
            color: var(--blue-dark);
        }

        .option-card.correct {
            border-color: var(--green);
            background: #d7ffb8;
            color: var(--green-dark);
        }

        .option-card.wrong {
            border-color: var(--red);
            background: #ffdfe0;
            color: var(--red-dark);
        }

        .quiz-bottomBar {
            border-top: 2px solid var(--border-color);
            padding: 24px;
            background: #ffffff;
        }

        .quiz-bottom-inner {
            max-width: 960px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
        }

        .feedback-area {
            flex: 1;
            font-size: 1rem;
            line-height: 1.45;
        }

        .feedback-area.ok { color: #2e6b00; }
        .feedback-area.err { color: #a31212; }
    </style>
</head>
